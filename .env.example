# Deployment configuration. See docs/DEPLOY.md for what each block is for and
# what breaks when it is wrong. Copy to .env and fill in — never commit .env.

APP_NAME="দৈনিক সংবাদ"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

# Bangla-first. APP_LOCALE also selects the validation and auth message files.
APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=bn_BD

# Bylines, the admin's scheduling inputs and the date archive are all wall
# clock. Must agree with DB_TIMEZONE below — see docs/DEPLOY.md.
APP_TIMEZONE=Asia/Dhaka

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# MySQL, not SQLite. Article::search() falls back to LIKE on any other driver,
# so the MATCH ... AGAINST path production relies on would never run.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=newspaper
DB_USERNAME=
DB_PASSWORD=

# Pinned rather than inherited from the database server's system zone, which
# would make behaviour depend on the box. Must match APP_TIMEZONE: +06:00 is
# Asia/Dhaka.
DB_TIMEZONE=+06:00

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Requires HTTPS. AppServiceProvider forces the scheme in production anyway.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

# Every upload path names the `public` disk explicitly, so this is only the
# default for anything added later. Leave it pointing somewhere sane.
FILESYSTEM_DISK=public

# Verification and password-reset links go out over this. `log` is a
# development setting: with it, nobody can ever verify an address.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Site identity. Everything an editor can change at runtime lives in the
# `settings` table instead; these are the deployment-level values, and they are
# what the footer imprint and the JSON-LD publisher block read.
# ---------------------------------------------------------------------------
SITE_NAME_BN="দৈনিক সংবাদ"
SITE_NAME_EN="Dainik Songbad"
SITE_TAGLINE="সময়ের সাথে সত্যের পথে"
SITE_DESCRIPTION="বাংলাদেশ ও বিশ্বের সর্বশেষ খবর, রাজনীতি, খেলা, বিনোদন, ব্যবসা ও মতামত।"
SITE_EDITOR=
SITE_PUBLISHER=
SITE_ADDRESS=
SITE_PHONE=
SITE_EMAIL=

SOCIAL_FACEBOOK=
SOCIAL_YOUTUBE=
SOCIAL_TWITTER=
SOCIAL_INSTAGRAM=
SOCIAL_LINKEDIN=
SOCIAL_TIKTOK=

# ---------------------------------------------------------------------------
# OAuth sign-in. Safe to leave blank: the sign-in buttons render only for a
# provider whose client_id is set, so an unconfigured provider disappears
# rather than offering a button that fails.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

# ---------------------------------------------------------------------------
# Error alerting. Every channel is off when blank, which is the default — an
# unconfigured install logs exactly as it always did and pushes nothing.
#
# Alerts are throttled to one per distinct fault per ERROR_ALERT_THROTTLE
# minutes, under a hard ceiling of ERROR_ALERT_MAX_PER_HOUR across all faults.
# A thousand alerts is indistinguishable from none.
# ---------------------------------------------------------------------------
ERROR_ALERT_EMAIL=
ERROR_ALERT_WEBHOOK=
ERROR_ALERT_THROTTLE=60
ERROR_ALERT_MAX_PER_HOUR=20
ERROR_LOG_DAYS=30
